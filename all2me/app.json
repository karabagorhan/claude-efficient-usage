{
  "expo": {
    "name": "All2Me",
    "slug": "all2me",
    "scheme": "all2me",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.all2me",
      "infoPlist": {}
    },
    "android": {
      "package": "app.all2me",
      "adaptiveIcon": {
        "backgroundColor": "#7C5CFC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F7FF",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0E1016"
          }
        }
      ],
      "expo-notifications",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      "expo-localization",
      "expo-asset",
      "expo-status-bar",
      [
        "expo-calendar",
        {
          "calendarPermission": "All2Me, teslim tarihlerini ve görevlerini takvimine eklemek için takvim erişimi ister.",
          "remindersPermission": "All2Me, hatırlatıcılarını Anımsatıcılar'a eklemek için erişim ister."
        }
      ]
    ],
    "owner": "karabagorhans-team",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e6aaa816-b73e-48d5-9baf-5c2d0b9bcf93"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e6aaa816-b73e-48d5-9baf-5c2d0b9bcf93"
    }
  }
}
